# Docker Compose đọc file .env cùng thư mục. Tạo .env bằng: node scripts/init-env.mjs
# Bốn secret dưới đây để trống ở đây. Script điền chuỗi ngẫu nhiên 64 ký tự hex.
POSTGRES_PASSWORD=
MINIO_ROOT_USER=comic-minio
MINIO_ROOT_PASSWORD=
JWT_SECRET=
INTERNAL_SERVICE_TOKEN=

# Phiên đăng nhập, tính bằng giây
JWT_TTL_SECONDS=43200

# Địa chỉ trình duyệt dùng để gọi API, tải ảnh, và origin được phép gọi API
PUBLIC_API_URL=http://localhost:3000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
WEB_ORIGIN=http://localhost:5173

# Giao diện mạng mà web, API, MinIO mở cổng. Giữ 127.0.0.1 nếu chỉ dùng trên máy này
BIND_ADDRESS=127.0.0.1
